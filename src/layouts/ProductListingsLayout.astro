---
import "../styles/global.css";
import type { Page } from "astro";
import type { CategoryNode } from "../lib/productPagination";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Layout/Header.astro";
import Footer from "../components/Layout/Footer.astro";
import TextHero from "../components/Sections/TextHero.astro";
import Card from "../components/UI/Card.astro";
import ContactBlock from "../components/Sections/ContactBlock.astro";
import SectionTitle from "../components/Content/SectionTitle.astro";
import CategoryNav from "../components/UI/CategoryNav.astro";
import Pagination from "../components/UI/Pagination.astro";

interface Props {
  pageType: "rental" | "sale";
  headline: string;
  page: Page;
  categoryTree: CategoryNode[];
  totalCount: number;
  activeCategory: string;
  activeTrail: string[];
}

const {
  pageType,
  headline,
  page,
  categoryTree,
  totalCount,
  activeCategory,
  activeTrail,
} = Astro.props;

const base = pageType === "rental" ? "/rentals" : "/sales";
const title = pageType === "rental" ? "Rentals | Powerjet" : "Sales | Powerjet";

function findTitle(nodes: CategoryNode[]): string | null {
  for (const n of nodes) {
    if (n.slug === activeCategory) return n.title;
    const found = findTitle(n.children);
    if (found) return found;
  }
  return null;
}
const activeTitle =
  activeCategory === "all"
    ? "All Products"
    : (findTitle(categoryTree) ?? "Products");

// "All Products" keeps the generic Sales/Rentals headline; a chosen
// category replaces it with that category's own title.
const heroHeadline = activeCategory === "all" ? headline : activeTitle;

// page.total is this category's full count across all its pages
const countLine =
  page.total === 0
    ? "No products found"
    : page.total <= page.size
      ? `Showing ${page.total} product${page.total !== 1 ? "s" : ""}`
      : `Showing ${page.start + 1}–${page.end + 1} of ${page.total} products`;
---

<BaseLayout title={title}>
  <Header transition:persist />
  <main id="main-content" class="page-grid product-listings-grid">
    <TextHero headline={heroHeadline} />

    <!-- Mobile: native disclosure, no JS -->
    <details class="mobile-filter">
      <summary class="mobile-filter__toggle">
        <span class="filter-label">
          <span class="material-symbols-outlined">filter_list</span>
          <span>{activeTitle}</span>
        </span>
        <span class="material-symbols-outlined dropdown-icon">expand_more</span>
      </summary>
      <nav class="mobile-filter__menu" aria-label="Product categories">
        <a
          href={`${base}/all/1`}
          class:list={["category-item", { active: activeCategory === "all" }]}
        >
          <span class="category-content">
            <span class="category-checkbox" aria-hidden="true"></span>
            <span class="category-title">All Products</span>
          </span>
          <span class="category-count">({totalCount})</span>
        </a>
      </nav>
      <CategoryNav
        nodes={categoryTree}
        base={base}
        activeCategory={activeCategory}
        activeTrail={activeTrail}
      />
    </details>

    <div class="products-layout">
      <aside class="sidebar-nav">
        <div class="sidebar-label">
          <span>Product categories</span>
        </div>
        <nav class="category-nav" aria-label="Product categories">
          <a
            href={`${base}/all/1`}
            class:list={["category-item", { active: activeCategory === "all" }]}
          >
            <span class="category-content">
              <span class="category-checkbox" aria-hidden="true"></span>
              <span class="category-title">All Products</span>
            </span>
            <span class="category-count">({totalCount})</span>
          </a>
        </nav>
        <CategoryNav
          nodes={categoryTree}
          base={base}
          activeCategory={activeCategory}
          activeTrail={activeTrail}
        />
      </aside>

      <div class="products-main">
        {
          page.data.length > 0 ? (
            <div class="products-grid">
              {page.data.map((product: any) => (
                <div class="product-card">
                  <Card
                    imageURL={product.imageUrl}
                    imageAlt={product.imageAlt}
                    href={`/products/${product.slug}`}
                    buttonLabel={product.title}
                    icon={true}
                    style="light"
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>Sorry, there are no products available in this category.</p>
            </div>
          )
        }

        <div class="products-footer">
          <p class="products-count" role="status" aria-live="polite">
            {countLine}
          </p>
          <Pagination page={page} base={`${base}/${activeCategory}`} />
        </div>
      </div>
    </div>
  </main>

  <Footer transition:persist />
</BaseLayout>

<style is:global>
  /* Only the products-layout row should absorb the page-grid's min-height:100vh
     slack; the hero, category heading and mobile filter stay auto-sized so they
     never resize based on how many products a category has. */
  .product-listings-grid {
    grid-template-rows: auto auto auto 1fr auto;
  }

  .sidebar-label {
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    padding: 0rem 1rem;
    margin-bottom: 1rem;
    color: var(--pj_brand_blue);
  }

  /* Mobile disclosure */
  .mobile-filter {
    grid-column: 2 / -2;
    margin-bottom: 2rem;
  }
  .mobile-filter__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    list-style: none;
    cursor: pointer;
    background: white;
    border: 1px solid var(--pj_blue_30);
    border-radius: 0.25rem;
    font-family: "Instrument Sans", sans-serif;
    color: var(--pj_brand_blue);
  }
  .mobile-filter__toggle::-webkit-details-marker {
    display: none;
  }
  .filter-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .dropdown-icon {
    transition: transform 0.3s ease;
  }
  .mobile-filter[open] .dropdown-icon {
    transform: rotate(180deg);
  }
  .mobile-filter__menu {
    margin-top: 0.5rem;
    padding: 0.5rem 0;
    border: 1px solid var(--pj_blue_30);
    border-radius: 0.25rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  /* Shared category nav (sidebar + mobile) */
  .category-nav,
  .mobile-filter__menu {
    display: flex;
    flex-direction: column;
  }
  .category-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .category-nav__list[data-level="2"] .category-item {
    padding-left: 2rem;
  }
  .category-nav__list[data-level="3"] .category-item {
    padding-left: 3rem;
  }
  .nested-categories.active {
    display: block;
  }

  .category-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.5rem 1rem;
    text-decoration: none;
    border-radius: 0.25rem;
    font-family: "Instrument Sans", sans-serif;
    font-size: 0.9375rem;
    color: var(--pj_brand_blue);
    transition: color 0.2s ease;
  }
  .category-content {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1;
  }
  .category-title {
    font-weight: 400;
    transition: font-weight 0.2s ease;
  }
  .category-item:hover .category-title {
    font-weight: 600;
  }
  .category-item.active .category-title,
  .category-item.expanded .category-title {
    font-weight: 600;
  }
  .category-checkbox {
    box-sizing: border-box;
    display: inline-flex;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    background-color: white;
    border: 1.5px solid var(--pj_blue_30);
    border-radius: 2px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      border-width 0.15s ease;
  }
  .category-item:hover .category-checkbox {
    border-width: 2px;
  }
  .category-item.active .category-checkbox,
  .category-item.expanded .category-checkbox {
    background-color: var(--pj_blue_40);
    border-color: var(--pj_blue_40);
  }
  .category-count {
    font-size: 0.875rem;
    color: var(--pj_blue_60);
    margin-left: 0.5rem;
  }
  .category-icon {
    font-size: 1.25rem;
    color: var(--pj_blue_60);
    transition: transform 0.2s ease;
  }
  .category-item.expanded .category-icon {
    transform: rotate(90deg);
  }

  /* Layout */
  .products-layout {
    grid-column: 2 / -2;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 5rem;
  }
  .sidebar-nav {
    display: none;
  }
  .products-main {
    flex: 1;
  }
  .products-header {
    margin-bottom: 1.5rem;
  }
  .products-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .products-count {
    font-size: 0.9375rem;
    color: var(--pj_blue_70);
    margin: 0;
  }
  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    row-gap: 6rem;
    margin-bottom: 3rem;
  }
  .product-card {
    transition: opacity 0.3s ease;
  }
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--pj_blue_70);
    background-color: var(--pj_blue_05);
    border-radius: 0.25rem;
    margin-bottom: 3rem;
  }

  @media screen and (min-width: 768px) {
    .mobile-filter {
      display: none;
    }
    .sidebar-nav {
      display: block;
      flex-shrink: 0;
      width: 280px;
      position: sticky;
      top: 2rem;
      align-self: flex-start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding-right: 1rem;
    }
    .products-layout {
      flex-direction: row;
    }
    .product-card {
      max-width: 350px;
    }
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 350px));
      justify-content: start;
    }
  }

  @media screen and (min-width: 1024px) {
    .sidebar-nav {
      width: 320px;
    }
    .product-card {
      max-width: 380px;
    }
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 340px));
    }
  }
</style>
