---
import Button from "../UI/Button.astro";

interface Props {
  title: string;
  datasheetUrl?: string;
  datasheetFileName?: string;
}

const { title, datasheetUrl, datasheetFileName } = Astro.props;

const quoteEmail = "mail@powerjet-uk.com";
const quoteSubject = encodeURIComponent(`Quote Request: ${title}`);
const quoteHref = `mailto:${quoteEmail}?subject=${quoteSubject}`;
---

<div class="product-actions">
  {
    datasheetUrl && (
      <Button
        type="button"
        variant="tertiary"
        href={datasheetUrl}
        download={datasheetFileName}
        target="_blank"
        rel="noopener noreferrer"
      >
        Download Datasheet
      </Button>
    )
  }
  <Button type="button" variant="primary" href={quoteHref}>
    Request a Quote
  </Button>
</div>

<style>
  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media screen and (min-width: 768px) {
    .product-actions {
      flex-direction: row;
    }
  }
</style>
