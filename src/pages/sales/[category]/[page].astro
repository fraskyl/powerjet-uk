---
import type { GetStaticPaths } from "astro";
import { buildProductPaths } from "../../../lib/productPagination";
import ProductListingsLayout from "../../../layouts/ProductListingsLayout.astro";

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) =>
  buildProductPaths(paginate, "sale")) satisfies GetStaticPaths;

const { page, categoryTree, totalCount, activeCategory, activeTrail } = Astro.props;
---

<ProductListingsLayout
  pageType="sale"
  headline="Sales"
  page={page}
  categoryTree={categoryTree}
  totalCount={totalCount}
  activeCategory={activeCategory}
  activeTrail={activeTrail}
/>
