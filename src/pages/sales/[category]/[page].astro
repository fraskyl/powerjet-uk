---
import { getProductPage } from "../../../lib/productPagination";
import ProductListingsLayout from "../../../layouts/ProductListingsLayout.astro";

const { category, page: pageParam } = Astro.params;
const result = category
  ? await getProductPage("sale", category, Number(pageParam))
  : null;

if (!result) return Astro.redirect("/404");

const { page, categoryTree, totalCount, activeCategory, activeTrail } = result;
---

<ProductListingsLayout
  pageType="sale"
  headline="Sales"
  page={page}
  categoryTree={categoryTree}
  totalCount={totalCount}
  activeCategory={activeCategory}
  activeTrail={activeTrail}
/>
